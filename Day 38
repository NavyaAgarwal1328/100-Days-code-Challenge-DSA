int leastInterval(char* tasks, int tasksSize, int n) {
    int freq[26] = {0};
    
    // count frequency
    for(int i = 0; i < tasksSize; i++){
        freq[tasks[i] - 'A']++;
    }
    
    // find max frequency
    int maxFreq = 0;
    for(int i = 0; i < 26; i++){
        if(freq[i] > maxFreq)
            maxFreq = freq[i];
    }
    
    // count tasks with max frequency
    int countMax = 0;
    for(int i = 0; i < 26; i++){
        if(freq[i] == maxFreq)
            countMax++;
    }
    
    int result = (maxFreq - 1) * (n + 1) + countMax;
    
    if(result > tasksSize)
        return result;
    else
        return tasksSize;
}
