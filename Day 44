int* preorderTraversal(struct TreeNode* root, int* returnSize) {
    int* res = malloc(100 * sizeof(int));
    *returnSize = 0;
    
    void dfs(struct TreeNode* node){
        if(node == NULL) return;
        
        res[(*returnSize)++] = node->val;
        dfs(node->left);
        dfs(node->right);
    }
    
    dfs(root);
    return res;
}
